    "css-tree": "^3.2.1",
    "culori": "^4.0.2",
    "diff": "^9.0.0",
    "dompurify": "3.4.17",
    "hash-wasm": "^4.12.0",
    "he": "^2.0.0",
    "html-minifier-terser": "^7.2.0",
    "javascript-obfuscator": "^5.9.0",
    "jsonc-parser": "^3.3.1",
    "jsqr": "1.4.0",
    "lucide-react": "^1.63.0",
    "marked": "18.1.2",
    "papaparse": "^5.7.0",
    "prettier": "^3.9.10",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql-formatter": "^15.9.0",
