    "@types/culori": "^4.0.1",
    "@types/he": "^1.2.3",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
